# Copy to .env (or run: node scripts/keys.js, which writes fresh test keys and prints only the addresses).
# Atlantic TESTNET keys only. .env is git-ignored; on Vercel these are project environment variables.

# The facilitator's signer: submits transferWithAuthorization and pays gas in PHRS.
FACILITATOR_PRIVATE_KEY=
# Where the payments go (an address, not a key).
PAY_TO_ADDRESS=
# The paying client (scripts/client.js). Needs TEST USDC (0xB691…6A2c) and a little PHRS for its one
# Permit2 approval. A .private_key file works too.
CLIENT_PRIVATE_KEY=
# Optional: kept only so the payTo wallet can be recovered.
SELLER_PRIVATE_KEY=

# Optional overrides
# ATLANTIC_RPC_URL=https://atlantic.dplabs-internal.com
# PACIFIC_RPC_URL=https://rpc.pharos.xyz
# FACILITATOR_URL=https://another-facilitator.example/facilitator
# ASSET=usdc-v2            (default test-usdc: TEST USDC through Permit2; usdc-v2: Circle USDC via EIP-3009)
