{
  "name": "pharos-x402-paywall",
  "version": "1.0.0",
  "description": "A pay-per-request API on Pharos Atlantic Testnet with x402: free and paid routes priced in test USDC, its own facilitator (/verify, /settle, /supported), and a client that pays and gets the data.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "server": "node scripts/server.js",
    "client": "node scripts/client.js",
    "web": "node scripts/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/fork-run.js",
    "fork": "node scripts/fork-run.js",
    "keys": "node scripts/keys.js"
  },
  "dependencies": {
    "@x402/core": "2.29.0",
    "@x402/evm": "2.29.0",
    "viem": "^2.57.5"
  },
  "optionalDependencies": {
    "@foundry-rs/anvil-linux-amd64": "^1.7.1",
    "@foundry-rs/anvil-win32-amd64": "^1.7.1"
  }
}
